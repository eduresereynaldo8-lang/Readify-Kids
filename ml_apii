"""
ml_api.py
==========
Readify Kids — ML Scoring API
Primary  : OpenAI Whisper API (whisper-1)
Fallback : Local Whisper Small model
"""

from flask import Flask, request, jsonify
from flask_cors import CORS
from dotenv import load_dotenv
import difflib
import os
import subprocess
import time

load_dotenv()

app = Flask(__name__)
CORS(app)

# ── OpenAI client ──────────────────────────────────────────────
import openai
openai.api_key = os.environ.get('OPENAI_API_KEY')

# ── Local Whisper fallback ─────────────────────────────────────
local_model = None

def get_local_model():
    global local_model
    if local_model is None:
        print('Loading local Whisper Small model as fallback...')
        import whisper
        local_model = whisper.load_model('small')
        print('Local Whisper Small loaded.')
    return local_model

# ── ffmpeg path ────────────────────────────────────────────────
BASE_DIR    = os.path.dirname(os.path.abspath(__file__))
FFMPEG_PATH = os.path.join(BASE_DIR, 'ffmpeg.exe') \
              if os.path.exists(os.path.join(BASE_DIR, 'ffmpeg.exe')) \
              else 'ffmpeg'

# ─────────────────────────────────────────────────────────────
def convert_to_wav(input_path: str) -> str:
    """Convert any audio format to 16kHz mono WAV."""
    output_path = input_path.rsplit('.', 1)[0] + '_converted.wav'
    try:
        result = subprocess.run([
            FFMPEG_PATH,
            '-i', input_path,
            '-ar', '16000',
            '-ac', '1',
            '-y',
            output_path
        ], capture_output=True, text=True)

        if result.returncode == 0 and os.path.exists(output_path):
            print(f'Converted to WAV: {output_path}')
            return output_path
        else:
            print(f'FFmpeg error: {result.stderr}')
            return input_path
    except Exception as e:
        print(f'FFmpeg exception: {e}')
        return input_path


def transcribe_with_api(audio_path: str) -> str:
    """Transcribe using OpenAI Whisper API (whisper-1)."""
    with open(audio_path, 'rb') as audio_file:
        response = openai.audio.transcriptions.create(
            model='whisper-1',
            file=audio_file,
            language='en',
        )
    if hasattr(response, 'text'):
        return response.text.strip()
    return str(response).strip()


def transcribe_with_local(audio_path: str) -> str:
    """Transcribe using local Whisper Small model."""
    model  = get_local_model()
    result = model.transcribe(audio_path, language='en', fp16=False)
    return result['text'].strip()


def transcribe_audio(audio_path: str) -> tuple:
    """
    Try OpenAI API first.
    Fall back to local Whisper Small if rate limited or API unavailable.
    Returns (transcript, method_used)
    """
    # ── Try OpenAI API ────────────────────────────────────────
    if os.environ.get('OPENAI_API_KEY'):
        for attempt in range(2):
            try:
                print(f'Trying OpenAI API (attempt {attempt + 1})...')
                transcript = transcribe_with_api(audio_path)
                print(f'OpenAI API success.')
                return transcript, 'openai-whisper-1'

            except openai.RateLimitError:
                print(f'Rate limit hit on attempt {attempt + 1}.')
                if attempt == 0:
                    print('Waiting 15 seconds before retry...')
                    time.sleep(15)
                else:
                    print('Rate limit persists. Falling back to local model.')
                    break

            except openai.AuthenticationError:
                print('Invalid API key. Falling back to local model.')
                break

            except Exception as e:
                print(f'API error: {e}. Falling back to local model.')
                break

    # ── Fallback to local Whisper Small ──────────────────────
    print('Using local Whisper Small model...')
    transcript = transcribe_with_local(audio_path)
    return transcript, 'local-whisper-small'


def compute_score(transcript: str, expected: str) -> float:
    """Compute similarity score 0-100 using SequenceMatcher."""
    transcript_clean = transcript.lower().strip()
    expected_clean   = expected.lower().strip()
    if not expected_clean:
        return 0.0
    similarity = difflib.SequenceMatcher(
        None, expected_clean, transcript_clean
    ).ratio()
    return round(similarity * 100, 2)


def compute_word_accuracy(transcript: str, expected: str) -> dict:
    """Word-level breakdown of correct, missed, and wrong words."""
    expected_words   = expected.lower().strip().split()
    transcript_words = transcript.lower().strip().split()
    correct  = [w for w in expected_words if w in transcript_words]
    missed   = [w for w in expected_words if w not in transcript_words]
    wrong    = [w for w in transcript_words if w not in expected_words]
    accuracy = round(len(correct) / len(expected_words) * 100, 2) \
               if expected_words else 0
    return {
        'correct'  : correct,
        'missed'   : missed,
        'wrong'    : wrong,
        'accuracy' : accuracy,
    }


