# ─────────────────────────────────────────────────────────────
@app.route('/health', methods=['GET'])
def health():
    api_key_set = bool(os.environ.get('OPENAI_API_KEY'))
    return jsonify({
        'status'      : 'ok',
        'model'       : 'openai/whisper-1 (API) with local fallback',
        'api_key_set' : api_key_set,
        'message'     : 'Readify Kids ML API is running!',
    })


@app.route('/score', methods=['POST'])
def score():
    data = request.get_json(force=True)

    if not data:
        return jsonify({'error': 'No JSON data received'}), 400

    recording_path = data.get('recording_path', '').strip()
    expected_text  = data.get('expected_text',  '').strip()

    print(f'\n{"="*50}')
    print(f'Recording  : {recording_path}')
    print(f'Expected   : {expected_text}')
    print(f'File exists: {os.path.exists(recording_path)}')

    if not recording_path:
        return jsonify({'error': 'recording_path is required'}), 400
    if not os.path.exists(recording_path):
        return jsonify({'error': f'File not found: {recording_path}'}), 404
    if not expected_text:
        return jsonify({'error': 'expected_text is required'}), 400

    try:
        # Convert to WAV
        wav_path = convert_to_wav(recording_path)
        print(f'Processing : {wav_path}')

        # Transcribe (API first, local fallback)
        transcript, method = transcribe_audio(wav_path)
        print(f'Transcript : {transcript}')
        print(f'Method     : {method}')

        # Cleanup converted file
        if wav_path != recording_path and os.path.exists(wav_path):
            os.remove(wav_path)

        # Compute scores
        score_val      = compute_score(transcript, expected_text)
        word_breakdown = compute_word_accuracy(transcript, expected_text)

        print(f'Score      : {score_val}%')
        print(f'{"="*50}\n')

        return jsonify({
            'score'         : score_val,
            'transcript'    : transcript,
            'expected'      : expected_text,
            'word_breakdown': word_breakdown,
            'model'         : method,
            'message'       : 'Scored successfully',
        })

    except Exception as e:
        print(f'Error: {str(e)}')
        import traceback
        traceback.print_exc()
        return jsonify({
            'error'  : str(e),
            'score'  : None,
            'message': 'Transcription failed',
        }), 500


@app.route('/transcribe-only', methods=['POST'])
def transcribe_only():
    data = request.get_json(force=True)
    if not data:
        return jsonify({'error': 'No data received'}), 400

    recording_path = data.get('recording_path', '').strip()
    if not recording_path or not os.path.exists(recording_path):
        return jsonify({'error': 'Recording file not found'}), 404

    try:
        wav_path             = convert_to_wav(recording_path)
        transcript, method   = transcribe_audio(wav_path)
        if wav_path != recording_path and os.path.exists(wav_path):
            os.remove(wav_path)
        return jsonify({
            'transcript': transcript,
            'model'     : method,
        })
    except Exception as e:
        return jsonify({'error': str(e)}), 500


